# Postgres connection
DATABASE_URL=postgres://electricademy:electricademy@localhost:5432/electricademy

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional: Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: email magic link (Nodemailer SMTP URL)
EMAIL_SERVER=
EMAIL_FROM=Electricademy <no-reply@example.com>

# Development only: enables a passwordless "dev login" by email. NEVER enable in production.
AUTH_DEV_LOGIN=true

# Optional: license-exam content limits and client IP (see "Content protection" in docs/ARCHITECTURE.md).
# Unset = defaults. CF-Connecting-IP is used automatically behind Cloudflare.
# CONTENT_LIMIT_USER_PER_MINUTE=40
# CONTENT_LIMIT_IP_PER_MINUTE=150
# CONTENT_LIMIT_USER_VIEWS_PER_DAY=400
# CONTENT_LIMIT_USER_ANSWERS_PER_DAY=300
# CONTENT_LIMIT_IP_VIEWS_PER_DAY=1000
# CONTENT_LIMIT_IP_ANSWERS_PER_DAY=800
# CLIENT_IP_HEADER=
# TRUSTED_PROXY_HOPS=1

# Optional: "התייעצות עם AI" in license-exam practice and browse (apps/web/src/lib/aiTiers.ts, lib/askAi.ts).
# Hidden until OPENROUTER_API_KEY and a model for the learner's tier are set. Paying learners (Pro, or the
# license-exam product) use the "pro" settings, everyone else the "free" ones. Models are OpenRouter ids.
# OPENROUTER_API_KEY=
# AI_MODEL_FREE=            e.g. google/gemma-4-31b-it:free (leave empty to give free learners no AI)
# AI_MODEL_PRO=             e.g. anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL=         fallback for a tier with no model of its own
# Tokens (prompt + reply + reasoning) per learner per day
# AI_TOKENS_PER_DAY_FREE=20000
# AI_TOKENS_PER_DAY_PRO=150000
# Optional cap for the whole site per day (all learners together)
# AI_TOKENS_PER_DAY_TOTAL=
# Reasoning effort for reasoning models (none | minimal | low | medium | high; default low)
# OPENROUTER_REASONING_EFFORT=low
