{
  "name": "electricademy",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev --filter=@electricademy/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @electricademy/db generate",
    "db:migrate": "pnpm --filter @electricademy/db migrate",
    "db:seed": "pnpm --filter @electricademy/db seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=22" }
}
